# 知涯 ZHIYA · 环境变量模板
#
# 使用方法：
#   cp .env.example .env.local
#   然后把下面的占位值换成你自己的密钥
#
# .env.local 已被 .gitignore 排除，不会提交到仓库。
# 请勿把真实密钥直接写进本文件或任何会被提交的文件。

# WorkBuddy 云服务地址
WB_CLOUD_ENDPOINT=https://zhiya-career.app.workbuddy.host

# 云服务公钥（前端可持有，后端服务端亦可用）
# 获取方式：WorkBuddy 应用管理后台 → 云服务 → 公钥
WB_CLOUD_PUBLISHABLE_KEY=wbpk_在此填入你的公钥

# 模型 id
# 注意：glm-4.7 在目录里标记 enabled，但实际调用报 request_invalid_parameter，不要用
ZHIYA_MODEL=deepseek-v4.1-flash

# 后端端口
PORT=5178
